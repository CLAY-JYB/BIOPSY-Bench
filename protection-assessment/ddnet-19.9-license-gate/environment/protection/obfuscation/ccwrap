#!/bin/sh
# CMake C-compiler wrapper: route verification.c through clang + xollvm
# obfuscation pass; everything else (incl. compiler-id probes, links) -> gcc.
for a in "$@"; do
  case "$a" in
    *verification.c)
      exec env LD_LIBRARY_PATH=/opt/llvm-22/lib \
        /opt/llvm-22/bin/clang -fpass-plugin=/usr/local/lib/Obfuscator.so "$@" ;;
  esac
done
exec gcc "$@"
