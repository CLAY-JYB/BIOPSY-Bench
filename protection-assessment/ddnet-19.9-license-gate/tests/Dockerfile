FROM ubuntu:22.04@sha256:0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982
ENV DEBIAN_FRONTEND=noninteractive QT_QPA_PLATFORM=offscreen

# Thin verifier image: pure consumer. binary / ground_truth / deps.tar.gz are construction-time exports from the environment build (see script/pipeline/export_verifier_artifacts.sh).
# Only the tools test.sh drives live here; versions mirror the environment toolchain's pins so parsed tool output stays identical.

RUN apt-get update && apt-get install -y --no-install-recommends \
    gdb \
    lldb-15 \
    ltrace \
    strace \
    valgrind \
    binutils \
    file \
    jq \
    bc \
    ent \
    python3 \
    util-linux \
    # BEGIN RUNTIME CLOSURE (generated by script/pipeline/export_verifier_artifacts.sh — do not edit)
    libbrotli1 \
    libcom-err2 \
    libcurl4 \
    libffi8 \
    libgmp10 \
    libgnutls30 \
    libgssapi-krb5-2 \
    libhogweed6 \
    libidn2-0 \
    libk5crypto3 \
    libkeyutils1 \
    libkrb5-3 \
    libkrb5support0 \
    libldap-2.5-0 \
    libnettle8 \
    libnghttp2-14 \
    libp11-kit0 \
    libpsl5 \
    librtmp1 \
    libsasl2-2 \
    libsqlite3-0 \
    libssh-4 \
    libtasn1-6 \
    libunistring2 \
    libzstd1 \
    zlib1g \
    # END RUNTIME CLOSURE
    && rm -rf /var/lib/apt/lists/*

# Custom target runtime libs: construction-time export from the environment build, tarred at their original /opt paths. ldconfig makes them resolvable even when LD_LIBRARY_PATH is stripped by the privilege drop.
COPY deps.tar.gz /tmp/deps.tar.gz
RUN tar xzf /tmp/deps.tar.gz -C / && rm /tmp/deps.tar.gz && \
    printf '%s\n' "/opt/target-deps" > /etc/ld.so.conf.d/target.conf && ldconfig
# the printf's substitution slot = the custom lib dirs discovered inside deps.tar.gz, resolved by export_verifier_artifacts.sh (quoted, space-separated).

# Challenge binary + ground truth: deterministic construction-time exports from the environment build (protection pipeline is seeded and deterministic). test.sh reads these at the paths the old baked-in copies used, so test.sh itself is unchanged.
COPY binary /app/binary
RUN chmod 755 /app/binary
COPY ground_truth/ /app/ground_truth/

# Verifier entrypoint (harbor separate mode: the image owns /tests/test.sh)
COPY test.sh /tests/test.sh
RUN chmod +x /tests/test.sh && mkdir -p /logs/verifier && \
    ln -sf /usr/bin/lldb-15 /usr/bin/lldb

# ==============================================================================
# Final Directory Structure
# ==============================================================================
#
# /app/
# ├── binary                        # Challenge binary (export from env build)
# └── ground_truth/                 # Ground truth for verifier comparison
#     ├── input.txt                 # Correct license key
#     └── binaries/
#         └── origin_binary         # Original unprotected binary (oracle)
#
# /logs/
# └── verifier/                     # Verifier output (EMPTY at build time;
# harbor mounts it; test.sh writes the rewards)
#
# Runtime (harbor upload at verify time): /logs/artifacts/agent_output/     # Agent output compared against ground truth
