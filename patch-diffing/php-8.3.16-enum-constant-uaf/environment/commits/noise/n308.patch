diff --git a/ext/spl/tests/SplFileObject_getCurrentLine_invalid_override.phpt b/ext/spl/tests/SplFileObject_getCurrentLine_invalid_override.phpt
new file mode 100644
index 00000000..35018163
--- /dev/null
+++ b/ext/spl/tests/SplFileObject_getCurrentLine_invalid_override.phpt
@@ -0,0 +1,22 @@
+--TEST--
+Invalid SplFileObject::getCurrentLine() return type
+--FILE--
+<?php
+
+class MySplFileObject extends SplFileObject {
+    #[ReturnTypeWillChange]
+    public function getCurrentLine(): array {
+        return [1, 2, 3];
+    }
+}
+
+$obj = new MySplFileObject(__FILE__);
+try {
+    var_dump($obj->current());
+} catch (TypeError $e) {
+    echo $e->getMessage(), "\n";
+}
+
+?>
+--EXPECT--
+MySplFileObject::getCurrentLine(): Return value must be of type string, array returned
