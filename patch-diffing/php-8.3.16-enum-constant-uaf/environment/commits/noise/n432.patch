-$tester = new FPM\Tester($cfg);
-$tester->start();
-$tester->expectLogError('Invalid routing table id 68000, max is 1');
-$tester->terminate();
-$tester->close();
-
-?>
-Done
---EXPECT--
-Done
---CLEAN--
-<?php
-require_once "tester.inc";
-FPM\Tester::clean();
-?>
