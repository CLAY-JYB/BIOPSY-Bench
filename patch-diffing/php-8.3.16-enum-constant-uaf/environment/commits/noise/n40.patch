-    var_dump(quux(...));
-}
-
-?>
---EXPECT--
-object(Closure)#2 (2) {
-  ["function"]=>
-  string(12) "Foo\Bar::baz"
-  ["this"]=>
-  object(Foo\Bar)#1 (0) {
-  }
-}
-object(Closure)#2 (1) {
-  ["function"]=>
-  string(12) "Foo\Bar::qux"
-}
-object(Closure)#2 (1) {
-  ["function"]=>
-  string(12) "Foo\Bar::qux"
-}
-object(Closure)#2 (1) {
-  ["function"]=>
-  string(8) "Foo\quux"
-}
