---TEST--
-GH-8962: Display function name when var_dumping fake closure
---FILE--
-<?php
-
-namespace Foo {
-    class Bar {
-        public function baz() {}
-        public static function qux() {}
-    }
-
-    function quux() {}
-
-    var_dump(\Closure::fromCallable([new Bar(), 'baz']));
-    var_dump(\Closure::fromCallable([Bar::class, 'qux']));
