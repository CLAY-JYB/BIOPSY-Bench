diff --git a/sapi/fpm/tests/bug68591-conf-test-group.phpt b/sapi/fpm/tests/bug68591-conf-test-group.phpt
deleted file mode 100644
index d496d054..00000000
--- a/sapi/fpm/tests/bug68591-conf-test-group.phpt
+++ /dev/null
@@ -1,39 +0,0 @@
---TEST--
-FPM: bug68591 - config test group existence
---SKIPIF--
-<?php
-include "skipif.inc";
-?>
---FILE--
-<?php
-
-require_once "tester.inc";
-
-$cfg = <<<EOT
-[global]
-error_log = {{FILE:LOG}}
-[unconfined]
-listen = {{ADDR:UDS}}
-user = root
-group = aaaaaa
-pm = dynamic
-pm.max_children = 5
-pm.start_servers = 2
-pm.min_spare_servers = 1
-pm.max_spare_servers = 3
-EOT;
-
-$tester = new FPM\Tester($cfg);
-$tester->testConfig();
-
-?>
-Done
---EXPECT--
-ERROR: [pool unconfined] cannot get gid for group 'aaaaaa'
-ERROR: FPM initialization failed
-Done
---CLEAN--
-<?php
-require_once "tester.inc";
-FPM\Tester::clean();
-?>
