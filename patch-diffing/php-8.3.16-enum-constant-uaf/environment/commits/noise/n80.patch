-static zend_always_inline zend_ulong zend_object_to_weakref_key(const zend_object *object)
-{
-	ZEND_ASSERT(((uintptr_t)object) % ZEND_MM_ALIGNMENT == 0);
-	return ((uintptr_t) object) >> ZEND_MM_ALIGNMENT_LOG2;
-}
