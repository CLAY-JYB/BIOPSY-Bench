-    static $nameNullsafe = A::Case?->name;
-    static $valueNullsafe = A::Case?->value;
-
-    var_dump($name);
-    var_dump($value);
-    var_dump($nameNullsafe);
-    var_dump($valueNullsafe);
-}
-
-foo();
-
-?>
