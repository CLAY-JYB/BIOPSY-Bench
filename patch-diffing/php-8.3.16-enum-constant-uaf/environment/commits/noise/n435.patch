+foreach ($testDirs as $testDir) {
+    $it = new RecursiveIteratorIterator(
+        new RecursiveDirectoryIterator($testDir),
+        RecursiveIteratorIterator::LEAVES_ONLY
+    );
+
+    foreach ($it as $file) {
+        if (!preg_match('/\.phpt$/', $file)) continue;
+        $fullCode = file_get_contents($file);
