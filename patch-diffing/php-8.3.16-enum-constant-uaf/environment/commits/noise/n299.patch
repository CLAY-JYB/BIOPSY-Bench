@@ -1,24 +0,0 @@
---TEST--
-SplFileObject::fread function
---FILE--
-<?php
-$obj = new SplFileObject(__FILE__, 'r');
-$data = $obj->fread(5);
-var_dump($data);
-
-try {
-    $data = $obj->fread(0);
-    var_dump($data);
-} catch (\ValueError $e) {
-    echo $e->getMessage() . \PHP_EOL;
-}
-
-// read more data than is available
