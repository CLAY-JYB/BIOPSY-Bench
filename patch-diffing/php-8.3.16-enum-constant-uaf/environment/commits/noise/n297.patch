-include_path=.
---FILE--
-<?php
-file_put_contents('csv_control_data_error003.csv',
-<<<CDATA
-'groene appelen'|10
-'gele bananen'|20
-'rode kersen'|30
-CDATA
-);
-$s = new SplFileObject('csv_control_data_error003.csv');
