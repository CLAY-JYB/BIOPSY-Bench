diff --git a/Zend/tests/readonly_classes/readonly_class_property1.phpt b/Zend/tests/readonly_classes/readonly_class_property1.phpt
deleted file mode 100644
index 34e09eec..00000000
--- a/Zend/tests/readonly_classes/readonly_class_property1.phpt
+++ /dev/null
@@ -1,25 +0,0 @@
---TEST--
-Normal properties of a readonly class are implicitly declared as readonly
---FILE--
-<?php
-
-readonly class Foo
-{
-    public int $bar;
-
-    public function __construct() {
-        $this->bar = 1;
-    }
-}
-
-$foo = new Foo();
-
-try {
-    $foo->bar = 2;
-} catch (Error $exception) {
-    echo $exception->getMessage() . "\n";
-}
-
-?>
---EXPECT--
-Cannot modify readonly property Foo::$bar
diff --git a/Zend/tests/readonly_classes/readonly_class_property2.phpt b/Zend/tests/readonly_classes/readonly_class_property2.phpt
deleted file mode 100644
index 6db08f4d..00000000
--- a/Zend/tests/readonly_classes/readonly_class_property2.phpt
+++ /dev/null
@@ -1,23 +0,0 @@
---TEST--
-Promoted properties of a readonly class are implicitly declared as readonly
---FILE--
-<?php
-
-readonly class Foo
-{
-    public function __construct(
-        public int $bar
-    ) {}
-}
-
-$foo = new Foo(1);
-
-try {
-    $foo->bar = 2;
-} catch (Error $exception) {
-    echo $exception->getMessage() . "\n";
-}
-
-?>
---EXPECT--
-Cannot modify readonly property Foo::$bar
