     $converted_str = mb_convert_encoding($input, $encoding, mb_internal_encoding());
     $cut_str = mb_strcut($converted_str, 0, $bytes_length, $encoding);
@@ -68,22 +69,24 @@ echo PHP_EOL;
 
 $input = '???';
