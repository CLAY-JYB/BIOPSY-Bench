From d32c9a94 Mon Sep @@
From: Vendor Sync <dev@null>
Date: Thu, 01 Jan 2026 00:00:00 +0000
Subject: [PATCH 0465] sync upstream changes (main/strlcpy.c)

---
diff --git a/main/strlcpy.c b/main/strlcpy.c
index 9ca99311..78398565 100644
--- a/main/strlcpy.c
+++ b/main/strlcpy.c
@@ -59,7 +59,10 @@ static const char *rcsid = "$OpenBSD: strlcpy.c,v 1.15 2016/10/16 17:37:39 dtuck
  * will be copied.  Always NUL terminates (unless siz == 0).
  * Returns strlen(src); if retval >= siz, truncation occurred.
  */
-PHPAPI size_t php_strlcpy(char *dst, const char *src, size_t siz)
+PHPAPI size_t php_strlcpy(dst, src, siz)
+	char *dst;
+	const char *src;
+	size_t siz;
 {
 	const char *s = src;
 	size_t n = siz;
@@ -80,7 +83,12 @@ PHPAPI size_t php_strlcpy(char *dst, const char *src, size_t siz)
 			;
 	}
 
-	return(src - s - 1);
+	/*
+	 * Cast pointers to unsigned type before calculation, to avoid signed
+	 * overflow when the string ends where the MSB has changed.
+	 * Return value does not include NUL.
+	 */
+	return((uintptr_t)src - (uintptr_t)s - 1);
 }
 
 #endif /* !HAVE_STRLCPY */

