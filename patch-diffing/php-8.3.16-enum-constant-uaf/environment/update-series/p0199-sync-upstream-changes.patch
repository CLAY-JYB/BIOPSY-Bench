---TEST--
-Random: Randomizer: shuffleBytes(): Basic functionality
---FILE--
-<?php
-
-use Random\Engine;
-use Random\Engine\Mt19937;
-use Random\Engine\PcgOneseq128XslRr64;
-use Random\Engine\Secure;
-use Random\Engine\Test\TestShaEngine;
