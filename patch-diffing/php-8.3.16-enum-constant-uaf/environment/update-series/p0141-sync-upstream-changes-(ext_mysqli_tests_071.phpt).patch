diff --git a/ext/mysqli/tests/071.phpt b/ext/mysqli/tests/071.phpt
index 39d8ba77..8a5334d4 100644
--- a/ext/mysqli/tests/071.phpt
+++ b/ext/mysqli/tests/071.phpt
@@ -16,8 +16,22 @@ require_once('skipifconnectfailure.inc');
     var_dump($mysql->ping());
 
