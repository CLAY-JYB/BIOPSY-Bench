+	/* Clean param bind */
+	php_free_stmt_bind_buffer(stmt->param, FETCH_SIMPLE);
+	/* Clean output bind */
+	php_free_stmt_bind_buffer(stmt->result, FETCH_RESULT);
+
+	if (!Z_ISUNDEF(stmt->link_handle)) {
+		zval_ptr_dtor(&stmt->link_handle);
+	}
+#endif
 	if (stmt->query) {
 		efree(stmt->query);
 	}
