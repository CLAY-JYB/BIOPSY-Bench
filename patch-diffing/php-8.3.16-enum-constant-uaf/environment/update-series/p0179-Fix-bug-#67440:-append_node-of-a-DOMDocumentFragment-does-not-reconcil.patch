+<?php
+require(__DIR__."/connect.inc");
+// The bind buffer size edge cases seem to change each DB version.
+preg_match('/.*Release ([[:digit:]]+)\.([[:digit:]]+)\.([[:digit:]]+)\.([[:digit:]]+)\.([[:digit:]]+)*/', oci_server_version($c), $matches);
