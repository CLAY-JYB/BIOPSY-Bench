diff --git a/ext/phar/zip.c b/ext/phar/zip.c
index 1804d926..675cb7f6 100644
--- a/ext/phar/zip.c
+++ b/ext/phar/zip.c
@@ -1203,6 +1203,7 @@ int phar_zip_flush(phar_archive_data *phar, char *user_stub, zend_long len, int
 	char *pos;
 	static const char newstub[] = "<?php // zip-based phar archive stub file\n__HALT_COMPILER();";
 	char halt_stub[] = "__HALT_COMPILER();";
+	char *tmp;
 
 	php_stream *stubfile, *oldfile;
 	int free_user_stub, closeoldfile = 0;
@@ -1305,7 +1306,9 @@ int phar_zip_flush(phar_archive_data *phar, char *user_stub, zend_long len, int
 			free_user_stub = 0;
 		}
 
-		if ((pos = php_stristr(user_stub, halt_stub, len, sizeof(halt_stub) - 1)) == NULL) {
+		tmp = estrndup(user_stub, len);
+		if ((pos = php_stristr(tmp, halt_stub, len, sizeof(halt_stub) - 1)) == NULL) {
+			efree(tmp);
 			if (error) {
 				spprintf(error, 0, "illegal stub for zip-based phar \"%s\"", phar->fname);
 			}
@@ -1314,6 +1317,8 @@ int phar_zip_flush(phar_archive_data *phar, char *user_stub, zend_long len, int
 			}
 			return EOF;
 		}
+		pos = user_stub + (pos - tmp);
+		efree(tmp);
 
 		len = pos - user_stub + 18;
 		entry.fp = php_stream_fopen_tmpfile();
