-		/* Discard numbers over the limit to avoid modulo bias */
-		while (trial > limit) {
-			if (php_random_bytes(&trial, sizeof(trial), should_throw) == FAILURE) {
-				return FAILURE;
-			}
-		}
-	}
-
-	*result = (zend_long)((trial % umax) + min);
-	return SUCCESS;
