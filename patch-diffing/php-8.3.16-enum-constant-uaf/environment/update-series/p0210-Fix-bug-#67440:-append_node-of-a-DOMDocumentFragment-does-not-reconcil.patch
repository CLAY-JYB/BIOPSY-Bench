+--TEST--
+SPL: SplFileObject::fgetc
+--FILE--
+<?php
+
+function test($name)
+{
+    echo "===$name===\n";
+
+    $o = new SplFileObject(__DIR__ . '/' . $name);
+
+    var_dump($o->key());
+    while(($c = $o->fgetc()) !== false)
+    {
+        // Kinda ugly but works around new lines mess
+        if ($c === "\r") {
+            continue;
+        }
+        var_dump($o->key(), $c, $o->eof());
+    }
+    echo "===EOF?===\n";
+    var_dump($o->eof());
+    var_dump($o->key());
+    var_dump($o->eof());
+}
+
+test('fileobject_001a.txt');
+test('fileobject_001b.txt');
+
+?>
+--EXPECT--
+===fileobject_001a.txt===
+int(0)
+int(0)
+string(1) "0"
+bool(false)
+int(1)
+string(1) "
+"
+bool(false)
+int(1)
+string(1) "1"
+bool(false)
+int(2)
+string(1) "
+"
+bool(false)
+int(2)
