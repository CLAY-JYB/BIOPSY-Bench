+		} else if ((mode & MBFL_FILT_TL_HAN2ZEN_HIRAGANA) && c >= 0xff61 && c <= 0xff9f) {
+			return 0x3000 + hankana2zenhira_table[c - 0xff60];
+		}
+	}
