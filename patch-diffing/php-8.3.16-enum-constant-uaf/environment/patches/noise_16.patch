+	mbfl_no_encoding_wchar,
+	mbfl_no_encoding_wchar,
+	mbfl_filt_conv_common_ctor,
+	NULL,
+	mbfl_filt_tl_jisx0201_jisx0208,
+	mbfl_filt_tl_jisx0201_jisx0208_flush,
+	NULL,
+};
