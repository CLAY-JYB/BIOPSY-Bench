+				bind[ofs].buffer_type = col_type;
+				bind[ofs].buffer = stmt->result.buf[ofs].val;
+				bind[ofs].is_null = &stmt->result.is_null[ofs];
+				bind[ofs].buffer_length = stmt->result.buf[ofs].buflen;
