+PHPAPI double php_combined_lcg(void) /* {{{ */
+{
+	int32_t q;
+	int32_t z;
+
+	if (!LCG(seeded)) {
+		lcg_seed();
+	}
+
+	MODMULT(53668, 40014, 12211, 2147483563L, LCG(s1));
+	MODMULT(52774, 40692, 3791, 2147483399L, LCG(s2));
+
+	z = LCG(s1) - LCG(s2);
+	if (z < 1) {
+		z += 2147483562;
+	}
+
+	return z * 4.656613e-10;
+}
