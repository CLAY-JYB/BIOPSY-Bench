index 00000000..6fd04420
--- /dev/null
+++ b/ext/standard/tests/random/random_int.phpt
@@ -0,0 +1,24 @@
+--TEST--
+Test normal operation of random_int()
+--FILE--
+<?php
+
+var_dump(is_int(random_int(10, 100)));
+
+$x = random_int(10, 100);
+var_dump($x >= 10 && $x <= 100);
+
+var_dump(random_int(-1000, -1) < 0);
+var_dump(random_int(-1, PHP_INT_MAX) >= -1);
+var_dump(is_int(random_int(PHP_INT_MIN, PHP_INT_MAX)));
+
+var_dump(random_int(42,42));
+
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+int(42)
diff --git a/ext/standard/tests/random/random_int_error.phpt b/ext/standard/tests/random/random_int_error.phpt
new file mode 100644
index 00000000..fe461275
--- /dev/null
+++ b/ext/standard/tests/random/random_int_error.phpt
@@ -0,0 +1,29 @@
+--TEST--
+Test error operation of random_int()
+--FILE--
+<?php
+//-=-=-=-
+
+try {
+    $randomInt = random_int();
+} catch (TypeError $e) {
+    echo $e->getMessage().PHP_EOL;
+}
+
+try {
+    $randomInt = random_int(42);
+} catch (TypeError $e) {
+    echo $e->getMessage().PHP_EOL;
+}
+
+try {
+    $randomInt = random_int(42,0);
+} catch (Error $e) {
+    echo $e->getMessage().PHP_EOL;
+}
+
+?>
+--EXPECT--
+random_int() expects exactly 2 arguments, 0 given
+random_int() expects exactly 2 arguments, 1 given
+random_int(): Argument #1 ($min) must be less than or equal to argument #2 ($max)
