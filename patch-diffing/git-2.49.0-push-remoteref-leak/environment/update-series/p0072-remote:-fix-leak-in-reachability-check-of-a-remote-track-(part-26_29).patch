Subject: [PATCH 0072] remote: fix leak in reachability check of a remote-track (part 26/29)

---
diff --git a/remote.c b/remote.c
index 8d666c16..539e5cea 100644
--- a/remote.c
+++ b/remote.c
@@ -2041,6 +2081,8 @@ static struct ref *get_expanded_map(const struct ref *remote_refs,
 		    !ignore_symref_update(expn_name, &scratch)) {
 			struct ref *cpy = copy_ref(ref);
 
+			if (cpy->peer_ref)
+				free_one_ref(cpy->peer_ref);
