diff --git a/testdata/fwd_oneport.tdir/fwd_oneport.post b/testdata/fwd_oneport.tdir/fwd_oneport.post
index 8aafab7ca..11c96dbae 100644
--- a/testdata/fwd_oneport.tdir/fwd_oneport.post
