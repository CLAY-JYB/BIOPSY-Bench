+    csv_str = CSV.generate do |csv|
+      csv.add_row [1, 2, 3]
+      csv << [4, 5, 6]
     end
+    csv_str.should == "1,2,3\n4,5,6\n"
+  end
 
-    it "accepts a col separator" do
-      csv_str = CSV.generate(col_sep: ";") do |csv|
