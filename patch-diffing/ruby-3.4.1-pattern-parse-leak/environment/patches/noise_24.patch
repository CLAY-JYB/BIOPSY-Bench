+      csv << [4, 5, 6]
     end
+    csv_str.should == "1;2;3\n4;5;6\n"
+  end
 
-    it "appends and returns the argument itself" do
-      str = ""
-      csv_str = CSV.generate(str) do |csv|
-        csv.add_row [1, 2, 3]
-        csv << [4, 5, 6]
-      end
-      csv_str.should equal str
-      str.should == "1,2,3\n4,5,6\n"
+  it "appends and returns the argument itself" do
+    str = ""
+    csv_str = CSV.generate(str) do |csv|
+      csv.add_row [1, 2, 3]
+      csv << [4, 5, 6]
     end
+    csv_str.should equal str
+    str.should == "1,2,3\n4,5,6\n"
   end
 end
