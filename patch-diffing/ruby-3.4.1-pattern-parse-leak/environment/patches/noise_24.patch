-ruby_version_is ""..."3.4" do
-  require 'csv'
-  require 'tempfile'
+describe "CSV.generate" do
 
-  describe "CSV.generate" do
-
-    it "returns CSV string" do
-      csv_str = CSV.generate do |csv|
