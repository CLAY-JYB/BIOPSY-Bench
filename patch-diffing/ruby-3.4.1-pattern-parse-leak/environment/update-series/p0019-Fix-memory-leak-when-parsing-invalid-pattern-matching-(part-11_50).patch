 static rb_encoding *
-rb_parser_string_encoding(rb_parser_string_t *str)
+rb_parser_enc_compatible_latter(struct parser_params *p, rb_parser_string_t *str1, rb_parser_string_t *str2, rb_encoding *enc1, rb_encoding *enc2)
