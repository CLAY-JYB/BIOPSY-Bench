diff --git a/parse.y b/parse.y
index 6836576d8..01b88c445 100644
--- a/parse.y
+++ b/parse.y
@@ -15078,11 +15467,11 @@ dsym_node(struct parser_params *p, NODE *node, const YYLTYPE *loc)
         nd_set_loc(node, loc);
         break;
       case NODE_STR:
