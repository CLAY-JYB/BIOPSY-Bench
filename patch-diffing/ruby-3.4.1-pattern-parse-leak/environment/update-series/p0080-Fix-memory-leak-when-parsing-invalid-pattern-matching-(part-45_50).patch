diff --git a/ruby_parser.c b/ruby_parser.c
index 89b2a19d4..9560c66ef 100644
--- a/ruby_parser.c
+++ b/ruby_parser.c
@@ -995,6 +1025,20 @@ rb_node_sym_string_val(const NODE *node)
