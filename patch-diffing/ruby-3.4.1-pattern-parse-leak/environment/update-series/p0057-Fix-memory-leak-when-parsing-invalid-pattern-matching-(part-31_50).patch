Subject: [PATCH 0057] Fix memory leak when parsing invalid pattern matching (part 31/50)

---
diff --git a/parse.y b/parse.y
index 6836576d8..01b88c445 100644
--- a/parse.y
+++ b/parse.y
@@ -13430,7 +13822,7 @@ new_xstring(struct parser_params *p, NODE *node, const YYLTYPE *loc)
         nd_set_loc(node, loc);
         break;
       default:
-        node = NEW_DXSTR(Qnil, 1, NEW_LIST(node, loc), loc);
+        node = NEW_DXSTR(0, 1, NEW_LIST(node, loc), loc);
         break;
     }
     return node;

